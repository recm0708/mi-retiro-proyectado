{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.2/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": {
      "style": "atx"
    },
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  },
  "ignores": [
    ".venv/**",
    "node_modules/**",
    "scripts/node_modules/**",
    "_deliverables/**",
    "_entregas/**",
    ".pytest_cache/**",
    "docs/archive/**"
  ],
  "overrides": [
    {
      "filter": [
        "README.md"
      ],
      "config": {
        "MD033": {
          "allowed_elements": [
            "p",
            "h1",
            "a",
            "img"
          ]
        },
        "MD041": {
          "allow_preamble": true
        }
      },
      "combine": "merge"
    },
    {
      "filter": [
        ".github/pull_request_template.md"
      ],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    },
    {
      "filter": [
        "docs/product/functional-specification.md"
      ],
      "config": {
        "MD025": false
      },
      "combine": "merge"
    }
  ],
  "showFound": false
}
