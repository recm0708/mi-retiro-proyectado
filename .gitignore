# ============================================================
# Mi Retiro Proyectado
# Archivos excluidos del control de versiones
# ============================================================

# Entornos virtuales y gestores de Python
.venv/
venv/
env/
ENV/

# Python: caché, compilados y metadatos
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
build/
dist/

# Variables de entorno, secretos y credenciales
.env
.env.*
!.env.example
*.pem
*.key

# Bases de datos y almacenamiento local
*.db
*.sqlite
*.sqlite3

# Datos personales, importaciones y originales de validación
# Los casos anonimizados sí pueden versionarse.
data/personales/
data/importaciones/
data/documentos_personales/
tests/validation_cases/originals/
tests/validation_cases/**/*.pdf
uploads/

# Salidas locales, temporales y logs
logs/
*.log
temp/
tmp/
*.tmp
*.temp
*.bak
*.swp
*~

# Pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Herramientas de análisis y caché
.mypy_cache/
.ruff_cache/
.pyright/

# IDE y editores
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Copias comprimidas y paquetes locales del proyecto
*.zip
*.7z
*.rar

# Paquetes temporales de auditoría local
_auditoria_repo_*/
