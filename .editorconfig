root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{html,css,js,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Se permite espacio final cuando se usa intencionalmente para salto de línea Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
